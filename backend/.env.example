PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL Neon / SQLite for local)
DATABASE_URL="file:./dev.db"

# JWT Authentication Secrets
JWT_SECRET="squi_super_secret_jwt_access_key_change_in_production"
JWT_REFRESH_SECRET="squi_super_secret_jwt_refresh_key_change_in_production"
JWT_EXPIRES_IN="7d"

# Storage Configuration (local | s3 | r2)
STORAGE_TYPE="local"
STORAGE_LOCAL_PATH="./uploads"
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_ENDPOINT=""
CLOUDFLARE_R2_PUBLIC_URL=""
